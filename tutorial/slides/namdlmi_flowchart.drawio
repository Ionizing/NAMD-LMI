        <mxCell id="4b1hSgGfzwB7K8v9WtSc-4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;comic=0;fontFamily=Tahoma;" parent="1" source="4b1hSgGfzwB7K8v9WtSc-5" target="4b1hSgGfzwB7K8v9WtSc-7" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="4b1hSgGfzwB7K8v9WtSc-5" value="&lt;font style=&quot;font-size: 16px;&quot;&gt;Fewest Switches Surface Hopping&lt;br&gt;&lt;/font&gt;$$&lt;br&gt;P_{jk}(t, \Delta t) = \max \left[-\frac{2\int_t^{t+\Delta t} \Re(\rho_{jk} H_{jk}^{\mathrm{LMI}}/i\hbar - \rho_{jk}T_{jk}) dt}{\rho_{jj}}, 0 \right]&lt;br&gt;$$" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;comic=0;fontStyle=1;fontFamily=Tahoma;flipV=1;" parent="1" vertex="1">
          <mxGeometry x="220" y="330" width="400" height="100" as="geometry" />
        </mxCell>
        <mxCell id="4b1hSgGfzwB7K8v9WtSc-6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;comic=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontFamily=Tahoma;" parent="1" source="4b1hSgGfzwB7K8v9WtSc-7" target="4b1hSgGfzwB7K8v9WtSc-9" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="450" y="520" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="4b1hSgGfzwB7K8v9WtSc-7" value="&lt;font style=&quot;font-size: 16px;&quot;&gt;Classical Path Approximation&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d80073;strokeColor=#A50040;comic=0;fontColor=#ffffff;opacity=60;fontFamily=Tahoma;fontStyle=1;flipV=1;" parent="1" vertex="1">
          <mxGeometry x="290" y="460" width="260" height="40" as="geometry" />
        </mxCell>
        <mxCell id="4b1hSgGfzwB7K8v9WtSc-8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;comic=0;fontFamily=Tahoma;" parent="1" source="4b1hSgGfzwB7K8v9WtSc-9" target="4b1hSgGfzwB7K8v9WtSc-10" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="4b1hSgGfzwB7K8v9WtSc-9" value="&lt;font style=&quot;&quot;&gt;&lt;span style=&quot;font-size: 16px;&quot;&gt;Detailed Balance Factor&lt;br&gt;&lt;/span&gt;&lt;/font&gt;$$&lt;br&gt;G_{jk} = P_{jk} B_{jk}; \quad B_{jk} = \begin{cases}&lt;br&gt;e^{-(\epsilon_j - \epsilon_k / k_B T)} &amp;amp; \epsilon_j &amp;gt; \epsilon_k \;\text{and}\;|E|=0\\[6pt]&lt;br&gt;1 &amp;amp; \epsilon_j \leq \epsilon_k&amp;nbsp;\;\text{or}\;|E|&amp;gt;0&lt;br&gt;\end{cases}&lt;br&gt;$$" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#bac8d3;strokeColor=#23445d;comic=0;fontFamily=Tahoma;fontStyle=1;flipV=1;" parent="1" vertex="1">
          <mxGeometry x="220" y="530" width="400" height="100" as="geometry" />
        </mxCell>
        <mxCell id="4b1hSgGfzwB7K8v9WtSc-10" value="&lt;font style=&quot;font-size: 16px;&quot;&gt;Result Analysis&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;comic=0;fillColor=#e1d5e7;strokeColor=#9673a6;fontFamily=Tahoma;fontStyle=1;flipV=1;" parent="1" vertex="1">
          <mxGeometry x="340" y="660" width="160" height="60" as="geometry" />
        </mxCell>
        <mxCell id="4b1hSgGfzwB7K8v9WtSc-11" value="" style="group;flipV=1;comic=0;fontFamily=Tahoma;" parent="1" vertex="1" connectable="0">
          <mxGeometry x="40" y="220" width="770" height="80" as="geometry" />
        </mxCell>
        <mxCell id="4b1hSgGfzwB7K8v9WtSc-12" value="&lt;font color=&quot;#0000ff&quot; style=&quot;font-size: 16px;&quot;&gt;&lt;b&gt;Coefficient Propagation&lt;/b&gt;&lt;/font&gt;&lt;br&gt;$$i\hbar \dot{c}_j(t) = \sum_k c_k(t) (\epsilon_k \delta_{jk} -i\hbar T_{jk} + H_{jk}^{\mathrm{LMI}})$$" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;comic=0;fontFamily=Tahoma;" parent="4b1hSgGfzwB7K8v9WtSc-11" vertex="1">
